{
  "name": "tournois-badpad",
  "main": "worker.js",
  "routes": [
    { "pattern": "tournois-badpad.fr", "custom_domain": true },
    { "pattern": "www.tournois-badpad.fr", "custom_domain": true },
    { "pattern": "pro.tournois-badpad.fr", "custom_domain": true }
  ],
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [{ "name": "EMAIL" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "padel",
      "database_id": "83afb012-3d5e-4e8e-ad92-c02bd3bcc37e"
    }
  ]
}
